# Test environment for E2E auth tests
# Copy to backend/.env before running tests

# Database
DATABASE_URL="postgresql://bookstrata:test_password@localhost:5433/bookstrata_test"

# JWT
JWT_SECRET="test-secret-key-for-e2e-auth-tests"
ACCESS_TOKEN_EXPIRY="60s"
REFRESH_TOKEN_EXPIRY="300s"

# Redis
REDIS_URL="redis://localhost:6380"

# Server
PORT=8080
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Disable email verification for tests
DISABLE_EMAIL_VERIFICATION=true

# Rate limits (high for tests)
RATE_LIMIT_REGISTER_MAX=1000
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_REFRESH_MAX=1000
